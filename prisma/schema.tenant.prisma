// prisma/schema.tenant.prisma

generator client {
  provider = "prisma-client-js"
  output   = "./generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SIMPLE
  TEMPLATE
  VARIANT
}

model TenantUser {
  id        String   @id @db.Uuid
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      String
  status    String
  createdAt DateTime
  updatedAt DateTime

  businessId String   @db.Uuid // Logical reference

  storeId   String?  @db.Uuid
  Store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  // Relations within tenant
  createdCustomers      Customer[]      @relation("CustomerCreator")
  mpesaPayments         MpesaPayment[]
  stockTransfers        StockTransfer[]
  createdSuppliers      Supplier[]      @relation("SupplierCreator")
  createdPurchaseOrders PurchaseOrder[] @relation("POCreator")
  createdStockReceipts  StockReceipt[]  @relation("ReceiptCreator")
  createdDeliveries     Delivery[]
  createdExpenses       Expense[]
  reconciliations       InventoryReconciliation[]

  @@index([businessId])
}

model MpesaPayment {
  id                String  @id @default(uuid()) @map("_id") @db.Uuid
  amount            Float
  phoneNumber       String
  accountReference  String
  transactionDesc   String?
  merchantRequestId String
  checkoutRequestId String  @unique
  status            String  @default("PENDING")

  // Relations
  invoiceId  String   @db.Uuid
  Invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  userId     String   @db.Uuid
  User       TenantUser @relation(fields: [userId], references: [id])
  
  businessId String   @db.Uuid // Logical reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([businessId])
  @@index([userId])
}

model Product {
  id           String        @id @default(uuid()) @map("_id") @db.Uuid
  name         String
  description  String
  price        Float
  sku          String        @unique
  quantity     Int           @default(0)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categoryId   String        @db.Uuid
  Category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inStock      Boolean       @default(false)
  invoiceItems InvoiceItem[]
  image        String?       @default("/images/default-product.png") @db.Text
  createdBy    String?
  
  businessId   String?       @db.Uuid // Logical reference

  // Variants Logic
  type               ProductType             @default(SIMPLE)
  parentId           String?                 @db.Uuid
  parent             Product?                @relation("ProductVariants", fields: [parentId], references: [id], onDelete: Cascade)
  variants           Product[]               @relation("ProductVariants")
  attributeValues    ProductAttributeValue[]
  storeInventories   StoreInventory[]
  stockTransfers     StockTransfer[]
  stockReceipts      StockReceipt[]
  purchaseOrderItems PurchaseOrderItem[]
  reconciliationItems ReconciliationItem[]

  @@index([businessId])
  @@index([businessId, sku])
  @@index([businessId, categoryId])
  @@index([createdBy])
}

model Attribute {
  id         String            @id @default(uuid()) @map("_id") @db.Uuid
  name       String // e.g., "Color", "Size"
  businessId String            @db.Uuid // Logical reference
  options    AttributeOption[]

  @@unique([name, businessId])
}

model AttributeOption {
  id                String                  @id @default(uuid()) @map("_id") @db.Uuid
  value             String // e.g., "Red", "XL"
  attributeId       String                  @db.Uuid
  attribute         Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttributeValue[]

  @@unique([value, attributeId])
}

model ProductAttributeValue {
  id                String          @id @default(uuid()) @map("_id") @db.Uuid
  productId         String          @db.Uuid
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeOptionId String          @db.Uuid
  attributeOption   AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeOptionId])
}

model Category {
  id          String    @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  description String?
  products    Product[]
  createdBy   String?
  businessId  String?   @db.Uuid // Logical reference

  @@unique([name, createdBy])
  @@index([businessId])
  @@index([createdBy])
}

model Invoice {
  id                  String               @id @default(uuid()) @map("_id") @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customerId          String?              @db.Uuid
  Customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceItems        InvoiceItem[]
  totalAmount         Float
  paymentType         String               @default("CASH")
  status              String               @default("PENDING")
  stockRestored       Boolean              @default(false)
  createdBy           String?
  invoiceName         String               @default("")
  mpesaPayments       MpesaPayment[]
  successfulCallbacks SuccessfulCallback[]
  failedCallbacks     FailedCallback[]
  storeId             String?              @db.Uuid
  Store               Store?               @relation(fields: [storeId], references: [id])
  isDeleted           Boolean              @default(false)
  
  businessId          String?              @db.Uuid // Logical reference

  @@index([businessId])
  @@index([storeId])
  @@index([createdBy])
}

model InvoiceItem {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  quantity  Int
  price     Float
  productId String   @db.Uuid
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoiceId String?  @db.Uuid
  Invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy String?

  @@index([invoiceId])
  @@index([productId])
  @@index([createdBy])
}

model Customer {
  id          String    @id @default(uuid()) @map("_id") @db.Uuid
  firstName   String?
  lastName    String?
  email       String?
  phoneNumber String
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  storeId     String?   @db.Uuid
  Store       Store?    @relation(fields: [storeId], references: [id])
  createdById String    @db.Uuid
  CreatedBy   TenantUser @relation("CustomerCreator", fields: [createdById], references: [id])
  
  businessId  String    @db.Uuid // Logical reference

  @@unique([businessId, email])
  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([storeId])
  @@index([createdById])
}

model FailedCallback {
  id                Int      @id @default(autoincrement())
  merchantRequestId String
  checkoutRequestId String
  resultCode        Int
  resultDesc         String
  createdAt         DateTime @default(now())
  invoiceId         String?  @db.Uuid
  Invoice           Invoice? @relation(fields: [invoiceId], references: [id])
}

model SuccessfulCallback {
  id                 Int      @id @default(autoincrement())
  merchantRequestId  String
  checkoutRequestId  String
  resultCode         Int
  resultDesc         String
  amount             Float
  mpesaReceiptNumber String
  transactionDate    BigInt
  phoneNumber        BigInt
  createdAt          DateTime @default(now())
  invoiceId          String?  @db.Uuid
  Invoice            Invoice? @relation(fields: [invoiceId], references: [id])
}

model Store {
  id         String   @id @default(uuid()) @map("_id") @db.Uuid
  name       String
  address    String?
  isActive   Boolean  @default(true)
  businessId String   @db.Uuid // Logical reference

  tenantUsers   TenantUser[]
  inventory     StoreInventory[]
  invoices      Invoice[]
  customers     Customer[]
  expenses       Expense[]
  stockReceipts StockReceipt[]
  purchaseOrders PurchaseOrder[]

  transfersOut StockTransfer[] @relation("OriginStore")
  transfersIn  StockTransfer[] @relation("DestinationStore")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries      Delivery[]
  reconciliations InventoryReconciliation[]

  @@unique([name, businessId])
  @@index([businessId])
}

model Supplier {
  id          String  @id @default(uuid()) @map("_id") @db.Uuid
  name        String
  email       String?
  phoneNumber String?
  address     String?
  isDeleted   Boolean @default(false)

  businessId String   @db.Uuid // Logical reference

  purchaseOrders PurchaseOrder[]
  stockReceipts  StockReceipt[]

  createdById String     @db.Uuid
  CreatedBy   TenantUser @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deliveries  Delivery[]

  @@index([businessId])
  @@index([createdById])
}

model PurchaseOrder {
  id          String  @id @default(uuid()) @map("_id") @db.Uuid
  reference   String
  totalAmount Float
  status      String  @default("PENDING") // PENDING, DELIVERED, CANCELLED
  isDeleted   Boolean @default(false)

  supplierId String   @db.Uuid
  Supplier   Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  businessId String   @db.Uuid // Logical reference

  storeId String? @db.Uuid
  Store   Store?  @relation(fields: [storeId], references: [id])

  createdById String   @db.Uuid
  CreatedBy   TenantUser @relation("POCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries Delivery[]

  @@index([businessId])
  @@index([supplierId])
  @@index([createdById])
}

model PurchaseOrderItem {
  id       String @id @default(uuid()) @map("_id") @db.Uuid
  quantity Int
  unitCost Float

  productId String  @db.Uuid
  Product   Product @relation(fields: [productId], references: [id])

  purchaseOrderId String        @db.Uuid
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockReceipt {
  id        String  @id @default(uuid()) @map("_id") @db.Uuid
  quantity  Int
  unitCost  Float
  totalCost Float
  reference String?

  productId String  @db.Uuid
  Product   Product @relation(fields: [productId], references: [id])

  storeId String @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id])

  supplierId String?   @db.Uuid
  Supplier   Supplier? @relation(fields: [supplierId], references: [id])

  businessId String   @db.Uuid // Logical reference

  createdById String   @db.Uuid
  CreatedBy   TenantUser @relation("ReceiptCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveryId String?   @db.Uuid
  Delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([storeId])
  @@index([productId])
  @@index([createdById])
}

model StoreInventory {
  id        String @id @default(uuid()) @map("_id") @db.Uuid
  storeId   String @db.Uuid
  productId String @db.Uuid
  quantity  Int    @default(0)

  Store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  Product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model StockTransfer {
  id            String @id @default(uuid()) @map("_id") @db.Uuid
  productId     String @db.Uuid
  quantity      Int
  originStoreId String @db.Uuid
  destStoreId   String @db.Uuid
  createdById   String @db.Uuid
  status        String @default("COMPLETED")

  Product          Product @relation(fields: [productId], references: [id])
  OriginStore      Store   @relation("OriginStore", fields: [originStoreId], references: [id])
  DestinationStore Store   @relation("DestinationStore", fields: [destStoreId], references: [id])
  CreatedBy        TenantUser @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([createdById])
}

model Response {
  id                  Int      @id @default(autoincrement())
  merchantRequestId   String
  checkoutRequestId   String
  responseCode        String
  responseDescription String
  customerMessage     String
  createdAt           DateTime @default(now())
}

model ResultResponse {
  id                       Int           @id @default(autoincrement())
  resultType               Int
  resultCode               Int
  resultDesc               String
  originatorConversationID String
  conversationID           String
  transactionID            String
  referenceDataId          Int
  referenceData            ReferenceData @relation(fields: [referenceDataId], references: [id])
  createdAt                DateTime      @default(now())
}

model ReferenceData {
  id              Int              @id @default(autoincrement())
  referenceItemId Int
  referenceItem   ReferenceItem    @relation(fields: [referenceItemId], references: [id])
  resultResponse  ResultResponse[]
  createdAt       DateTime         @default(now())
}

model ReferenceItem {
  id            Int             @id @default(autoincrement())
  key           String
  value         String
  referenceData ReferenceData[]
  createdAt     DateTime        @default(now())
}

model Expense {
  id       String   @id @default(uuid()) @map("_id") @db.Uuid
  title    String
  category String
  amount   Float
  date     DateTime @default(now())
  notes    String?
  status   String   @default("ACTIVE") // ACTIVE, VOIDED

  businessId String   @db.Uuid // Logical reference

  storeId String? @db.Uuid
  Store   Store?  @relation(fields: [storeId], references: [id])

  createdById String? @db.Uuid
  CreatedBy   TenantUser? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([storeId])
  @@index([status])
  @@index([createdById])
}

model KraDetails {
  id                  String  @id @default(cuid())
  kraPin              String  @unique
  taxpayerType        String
  taxpayerName        String
  pinStatus           String
  isAutoFilingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String?   @unique @db.Uuid // Logical reference
}

model KraTotReturn {
  id String @id @default(uuid()) @map("_id") @db.Uuid

  ackNumber   String @unique
  paymentSlip String

  computedTax    Float
  taxPayable     Float
  utilizedCredit Float @default(0.0)

  period String

  createdAt DateTime @default(now())

  businessId String   @db.Uuid // Logical reference

  @@index([businessId])
}

model Delivery {
  id        String  @id @default(uuid()) @map("_id") @db.Uuid
  reference String?
  totalCost Float   @default(0)
  status    String  @default("RECEIVED")

  supplierId String?   @db.Uuid
  Supplier   Supplier? @relation(fields: [supplierId], references: [id])

  storeId String @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id])

  businessId String   @db.Uuid // Logical reference

  createdById String @db.Uuid
  CreatedBy   TenantUser @relation(fields: [createdById], references: [id])

  receipts StockReceipt[]

  purchaseOrderId String?        @db.Uuid
  PurchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(uuid()) @map("_id") @db.Uuid
  action     String // e.g., "CREATE_PRODUCT", "DELETE_INVOICE", "ADJUST_STOCK"
  entityType String // e.g., "PRODUCT", "INVOICE", "PURCHASE_ORDER"
  entityId   String?
  details    String? // JSON string for metadata
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId     String
  businessId String   @db.Uuid // Logical reference

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
}

model InventoryReconciliation {
  id        String   @id @default(uuid()) @map("_id") @db.Uuid
  reference String?
  status    String   @default("COMPLETED") // COMPLETED, VOIDED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String   @db.Uuid // Logical reference

  storeId String @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id])

  userId String @db.Uuid
  User   TenantUser @relation(fields: [userId], references: [id])

  items ReconciliationItem[]

  @@index([businessId])
  @@index([storeId])
  @@index([userId])
}

model ReconciliationItem {
  id               String @id @default(uuid()) @map("_id") @db.Uuid
  reconciliationId String @db.Uuid
  productId        String @db.Uuid
  systemQuantity   Int // Qty in system at time of reconciliation
  physicalQuantity Int // Qty manually counted
  discrepancy      Int // physicalQuantity - systemQuantity

  Reconciliation InventoryReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  Product        Product                 @relation(fields: [productId], references: [id])

  @@index([reconciliationId])
  @@index([productId])
}
