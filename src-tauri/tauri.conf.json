{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SaleSense",
  "version": "1.0.0",
  "identifier": "com.salesense.desktop",
  "build": {
    "frontendDist": "https://trysalesense.online/dashboard",
    "devUrl": "http://localhost:3000/dashboard",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SaleSense",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
