{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "https://trysalesense.online/*"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": [
            "http",
            "https"
          ],
          "urls": [
            "^https?://.*"
          ]
        }
      ]
    }
  ]
}
